{
  "name": "@ultrafuzz/evmbench",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "benchmark": "pnpm run build && node dist/cli.js",
    "build": "tsc -p tsconfig.build.json && rm -rf dist/schema && cp -R src/schema dist/schema",
    "lock": "pnpm run build && node dist/update-lock.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@ultrafuzz/artifacts": "workspace:*",
    "yaml": "^2.8.0",
    "zod": "^4.4.3"
  },
  "homepage": "https://github.com/monad-developers/ultrafuzz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monad-developers/ultrafuzz.git",
    "directory": "packages/evmbench"
  },
  "bugs": {
    "url": "https://github.com/monad-developers/ultrafuzz/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
