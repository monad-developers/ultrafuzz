{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultrafuzz:schema:evmbench:profile:2",
  "title": "Ultrafuzz EVMBench execution profile",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "max_concurrency",
    "poll_interval_seconds",
    "workflow_timeout_seconds",
    "node_timeout_seconds",
    "model",
    "reasoning"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ultrafuzz.evmbench.profile.v2"
    },
    "id": {
      "enum": ["smoke", "full"]
    },
    "max_concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "poll_interval_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "workflow_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "node_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "reasoning": {
      "$ref": "#/$defs/safeId"
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}
