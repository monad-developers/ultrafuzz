{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultrafuzz:schema:evmbench:catalog:2",
  "title": "Ultrafuzz EVMBench audit catalog",
  "type": "object",
  "required": ["schema_version", "audits"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ultrafuzz.evmbench.catalog.v2"
    },
    "audits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/audit"
      }
    }
  },
  "$defs": {
    "audit": {
      "type": "object",
      "required": [
        "id",
        "repository",
        "framework",
        "target_commit",
        "audit_context_sha256",
        "ground_truth_manifest_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/evmbench-org/[A-Za-z0-9_.-]+\\.git$"
        },
        "framework": {
          "anyOf": [
            {
              "$ref": "#/$defs/safeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_commit": {
          "$ref": "#/$defs/commit"
        },
        "audit_context_sha256": {
          "$ref": "#/$defs/digest"
        },
        "ground_truth_manifest_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}
