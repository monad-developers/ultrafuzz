{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultrafuzz:schema:cli:report-bundle-manifest:3",
  "title": "Ultrafuzz report bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "included_roots",
    "excluded_roots",
    "excluded_patterns",
    "path_mappings",
    "entry_count_without_manifest"
  ],
  "properties": {
    "schema_version": {
      "const": "ultrafuzz.report-bundle-manifest.v3"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "included_roots": {
      "oneOf": [
        {
          "const": [
            "attempts.jsonl",
            "config.redactions.json",
            "config.resolved.toml",
            "events.jsonl",
            "graph.fingerprint",
            "graph.json",
            "plan.json",
            "run.json",
            "state.json",
            "usage.jsonl",
            "artifacts",
            "review",
            "events.index",
            "engine-logs"
          ]
        },
        {
          "const": ["report.json", "report.md"]
        }
      ]
    },
    "excluded_roots": {
      "const": ["workspaces"]
    },
    "excluded_patterns": {
      "const": ["artifacts/final-report/report.json.pre-*"]
    },
    "path_mappings": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_path", "archive_path"],
        "properties": {
          "source_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^engine-logs/[^\\u0000-\\u001f\\u007f\\\\]+$"
          },
          "archive_path": {
            "type": "string",
            "pattern": "^engine-logs(?:/entry-[0-9a-f]{64})+$"
          }
        }
      }
    },
    "omitted_files": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "reason": {
            "enum": ["file-size-limit", "symlink", "not-regular-file", "unsafe-path", "unreadable"]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "entry_count_without_manifest": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "scope": {
      "const": "report-only"
    },
    "verification": {
      "enum": ["verified", "not-checked"]
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["scope"],
        "properties": {
          "scope": {
            "const": "report-only"
          }
        }
      },
      "then": {
        "required": ["verification"],
        "properties": {
          "included_roots": {
            "const": ["report.json", "report.md"]
          },
          "path_mappings": {
            "maxItems": 0,
            "type": "array"
          },
          "omitted_files": {
            "maxItems": 0,
            "type": "array"
          },
          "entry_count_without_manifest": {
            "const": 2
          },
          "verification": {
            "enum": ["verified", "not-checked"]
          }
        }
      },
      "else": {
        "properties": {
          "included_roots": {
            "const": [
              "attempts.jsonl",
              "config.redactions.json",
              "config.resolved.toml",
              "events.jsonl",
              "graph.fingerprint",
              "graph.json",
              "plan.json",
              "run.json",
              "state.json",
              "usage.jsonl",
              "artifacts",
              "review",
              "events.index",
              "engine-logs"
            ]
          }
        },
        "not": {
          "required": ["verification"],
          "properties": {
            "verification": {}
          }
        }
      }
    }
  ]
}
