{
  "name": "@ultrafuzz/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "ultrafuzz": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "oclif": {
    "bin": "ultrafuzz",
    "commands": "./dist/commands",
    "topicSeparator": " "
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "pnpm --filter @ultrafuzz/cli... build && rm -rf dist-test && tsc -p tsconfig.test.json && node --test --test-concurrency=1 dist-test/test/*.test.js",
    "typecheck": "pnpm --filter @ultrafuzz/cli^... build && tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@oclif/core": "^4.11.11",
    "@ultrafuzz/artifacts": "workspace:*",
    "@ultrafuzz/config": "workspace:*",
    "@ultrafuzz/dashboard": "workspace:*",
    "@ultrafuzz/evals": "workspace:*",
    "@ultrafuzz/runtime": "workspace:*"
  }
}
