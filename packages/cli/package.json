{
  "name": "@ultrafuzz/cli",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "ultrafuzz": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "oclif": {
    "bin": "ultrafuzz",
    "commands": "./dist/commands",
    "topicSeparator": " "
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp -R schema dist/schema && node scripts/verify-schema-registry.mjs",
    "test": "pnpm --filter @ultrafuzz/cli... build && rm -rf dist-test && tsc -p tsconfig.test.json && node --test --test-concurrency=1 dist-test/test/*.test.js",
    "test:pr-smoke:prebuilt": "rm -rf dist-test && tsc -p tsconfig.test.json && node scripts/run-pr-smoke-tests.mjs",
    "typecheck": "pnpm --filter @ultrafuzz/cli^... build && tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@oclif/core": "^4.11.11",
    "@resvg/resvg-js": "^2.6.2",
    "@ultrafuzz/artifacts": "workspace:*",
    "@ultrafuzz/config": "workspace:*",
    "@ultrafuzz/dashboard": "workspace:*",
    "@ultrafuzz/evmbench": "workspace:*",
    "@ultrafuzz/evals": "workspace:*",
    "@ultrafuzz/modal": "workspace:*",
    "@ultrafuzz/references": "workspace:*",
    "@ultrafuzz/runtime": "workspace:*",
    "@ultrafuzz/topology": "workspace:*",
    "adm-zip": "^0.6.0",
    "tar-stream": "^3.2.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/tar-stream": "^3.1.4"
  }
}
