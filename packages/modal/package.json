{
  "name": "@ultrafuzz/modal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "ultrafuzz-modal": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "Dockerfile"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "smoke": "pnpm run build && node dist/cli.js smoke",
    "test": "vitest run",
    "typecheck": "pnpm --filter @ultrafuzz/modal^... build && tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@smithers-orchestrator/tool-context": "0.32.0",
    "@ultrafuzz/artifacts": "workspace:*",
    "@ultrafuzz/evals": "workspace:*",
    "@ultrafuzz/runtime": "workspace:*",
    "@ultrafuzz/security": "workspace:*",
    "modal": "0.9.0",
    "proper-lockfile": "4.1.2",
    "smol-toml": "^1.7.0",
    "tar-stream": "^3.2.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4",
    "@types/tar-stream": "^3.1.4"
  }
}
