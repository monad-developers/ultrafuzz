{
  "name": "@ultrafuzz/modal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "ultrafuzz-modal": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "Dockerfile",
    "security-requirements.lock",
    "smithers-seed",
    "toolchain-materials.json",
    "toolchain-materials.sha256"
  ],
  "ultrafuzzWorkflowExecutionDependencies": [
    "@ultrafuzz/artifacts",
    "@ultrafuzz/config",
    "@ultrafuzz/evals",
    "@ultrafuzz/runtime",
    "@ultrafuzz/security",
    "modal",
    "proper-lockfile",
    "smol-toml",
    "tar-stream",
    "yaml",
    "zod"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rm -rf dist/schema && cp -R schema dist/schema && node scripts/verify-schema-registry.mjs",
    "smoke": "pnpm run build && node dist/cli.js smoke",
    "test": "vitest run",
    "typecheck": "pnpm --filter @ultrafuzz/modal^... build && tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.207",
    "@moonshot-ai/kimi-code": "0.29.1",
    "@openai/codex": "0.146.0",
    "@ultrafuzz/artifacts": "workspace:*",
    "@ultrafuzz/config": "workspace:*",
    "@ultrafuzz/evals": "workspace:*",
    "@ultrafuzz/runtime": "workspace:*",
    "@ultrafuzz/security": "workspace:*",
    "bun": "1.3.14",
    "modal": "0.9.0",
    "proper-lockfile": "4.1.2",
    "pnpm": "11.21.0",
    "recon-generate": "0.0.42",
    "smol-toml": "1.7.0",
    "tar-stream": "3.2.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/proper-lockfile": "4.1.4",
    "@types/tar-stream": "3.1.4"
  }
}
