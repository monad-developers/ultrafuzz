{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultrafuzz:schema:modal:worker-result:2",
  "title": "Ultrafuzz Modal worker result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_type", "generation", "launch_generation", "attempt", "model_work_started", "counts", "checkpoint", "exit_category", "runtime_ms", "usage", "diagnostic_code"],
  "properties": {
    "schema_version": { "const": "ultrafuzz.modal.worker-result.v2" },
    "result_type": { "enum": ["partial", "terminal"] },
    "generation": { "$ref": "urn:ultrafuzz:schema:modal:common:1#/$defs/positiveInteger" },
    "launch_generation": { "$ref": "urn:ultrafuzz:schema:modal:common:1#/$defs/positiveInteger" },
    "attempt": { "$ref": "urn:ultrafuzz:schema:modal:common:1#/$defs/positiveInteger" },
    "model_work_started": { "type": "boolean" },
    "counts": { "$ref": "urn:ultrafuzz:schema:modal:common:1#/$defs/aggregateCounts" },
    "checkpoint": { "$ref": "urn:ultrafuzz:schema:modal:common:1#/$defs/checkpointMetadata" },
    "exit_category": { "enum": ["live", "finished", "capacity-unavailable", "authentication-failure", "sandbox-exited", "unreachable", "genuine-evaluation-failure"] },
    "runtime_ms": { "$ref": "urn:ultrafuzz:schema:modal:common:1#/$defs/nonNegativeInteger" },
    "usage": {
      "oneOf": [
        { "$ref": "urn:ultrafuzz:schema:modal:common:1#/$defs/aggregateUsage" },
        { "type": "null" }
      ]
    },
    "pricing": { "$ref": "urn:ultrafuzz:schema:modal:common:1#/$defs/pricingProvenance" },
    "diagnostic_code": { "enum": ["worker-live", "worker-finished", "capacity-unavailable", "authentication-failure", "sandbox-exited", "dependency-unreachable", "genuine-evaluation-failure", "terminal-run-non-resumable", "checkpoint-incompatible", "public-eval-diagnostics-invalid"] }
  },
  "allOf": [
    {
      "if": { "properties": { "result_type": { "const": "partial" } }, "required": ["result_type"] },
      "then": { "properties": { "exit_category": { "const": "live" } } },
      "else": { "properties": { "exit_category": { "not": { "const": "live" } } } }
    },
    {
      "if": { "properties": { "exit_category": { "const": "live" } }, "required": ["exit_category"] },
      "then": { "properties": { "diagnostic_code": { "const": "worker-live" } } }
    },
    {
      "if": { "properties": { "exit_category": { "const": "finished" } }, "required": ["exit_category"] },
      "then": { "properties": { "diagnostic_code": { "const": "worker-finished" } } }
    },
    {
      "if": { "properties": { "exit_category": { "const": "sandbox-exited" } }, "required": ["exit_category"] },
      "then": { "properties": { "diagnostic_code": { "const": "sandbox-exited" } } }
    }
  ]
}
