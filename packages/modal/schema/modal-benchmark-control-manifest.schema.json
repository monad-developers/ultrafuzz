{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultrafuzz:schema:modal:benchmark-control-manifest:1",
  "title": "Ultrafuzz Modal benchmark control manifest",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_commit",
    "repository",
    "generation",
    "mode",
    "benchmark",
    "execution",
    "image_name",
    "targets",
    "matrix_rows_per_pair",
    "control_timeout_seconds",
    "concurrency",
    "pairs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ultrafuzz.modal.benchmark-control-manifest.v1"
    },
    "candidate_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "generation": {
      "type": "string",
      "pattern": "^[1-9][0-9]*-[1-9][0-9]*$"
    },
    "mode": {
      "enum": ["smoke", "full"]
    },
    "benchmark": {
      "enum": ["evmbench", "ultrafuzz-bench"]
    },
    "execution": {
      "type": "object",
      "required": ["mode", "dry_run"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "modal"
        },
        "dry_run": {
          "const": false
        }
      }
    },
    "image_name": {
      "type": "string",
      "pattern": "^ufz-runner-[0-9a-f]{40}$"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "repository", "revision", "framework"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "repository": {
            "type": "string",
            "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "framework": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        }
      }
    },
    "matrix_rows_per_pair": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "control_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "concurrency": {
      "type": "object",
      "required": [
        "max_parallel_eval_rows_per_sandbox",
        "max_parallel_workflow_nodes_per_row",
        "max_live_runner_workflows_by_provider",
        "max_live_judge_rows"
      ],
      "additionalProperties": false,
      "properties": {
        "max_parallel_eval_rows_per_sandbox": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_parallel_workflow_nodes_per_row": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_live_runner_workflows_by_provider": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 4,
          "additionalProperties": false,
          "properties": {
            "openai": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "anthropic": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "deepseek": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "kimi": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "max_live_judge_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["pair", "benchmark", "mode", "lane", "model_slug", "provider", "config_path", "state_path"],
        "additionalProperties": false,
        "properties": {
          "pair": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "benchmark": {
            "enum": ["evmbench", "ultrafuzz-bench"]
          },
          "mode": {
            "enum": ["smoke", "full"]
          },
          "lane": {
            "enum": ["smoke", "full"]
          },
          "model_slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "provider": {
            "enum": ["openai", "anthropic", "deepseek", "kimi"]
          },
          "config_path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "state_path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "mode": {
            "const": "full"
          }
        },
        "required": ["mode"]
      },
      "then": {
        "type": "object",
        "properties": {
          "benchmark": {
            "const": "evmbench"
          },
          "pairs": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4
          },
          "concurrency": {
            "type": "object",
            "properties": {
              "max_live_runner_workflows_by_provider": {
                "type": "object"
              }
            }
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "benchmark": {
            "const": "ultrafuzz-bench"
          },
          "pairs": {
            "type": "array",
            "maxItems": 1
          },
          "concurrency": {
            "type": "object",
            "properties": {
              "max_live_runner_workflows_by_provider": {
                "type": "object",
                "maxProperties": 1
              }
            }
          }
        }
      }
    }
  ]
}
