{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultrafuzz:schema:runtime:pinned-submodule-snapshot:2",
  "title": "Ultrafuzz pinned submodule byte snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_commit", "source_tree", "top_level_roots", "recursive_gitlinks", "entries"],
  "properties": {
    "schema_version": { "const": "ultrafuzz.pinned-submodules.v2" },
    "source_commit": { "$ref": "#/$defs/gitObjectId" },
    "source_tree": { "$ref": "#/$defs/gitObjectId" },
    "top_level_roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "recursive_gitlinks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/gitlink" }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/directoryEntry" },
          { "$ref": "#/$defs/fileEntry" },
          { "$ref": "#/$defs/symlinkEntry" }
        ]
      }
    }
  },
  "$defs": {
    "gitObjectId": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))[^\\u0000-\\u001f\\u007f]+$"
    },
    "gitlink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "commit", "tree"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "commit": { "$ref": "#/$defs/gitObjectId" },
        "tree": { "$ref": "#/$defs/gitObjectId" }
      }
    },
    "directoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "mode"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "type": { "const": "directory" },
        "mode": { "const": 493 }
      }
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "mode", "size_bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "type": { "const": "file" },
        "mode": { "enum": [420, 493] },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 67108864 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "symlinkEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "target"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "type": { "const": "symlink" },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f\\\\]+$"
        }
      }
    }
  }
}
