{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultrafuzz:schema:runtime:smithers-reset-node:1",
  "title": "Ultrafuzz Smithers reset-node marker",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "smithers_run_id", "node_id", "applied_at"],
  "properties": {
    "reset_plan": { "$ref": "#/$defs/resetPlan" },
    "schema_version": {
      "const": "ultrafuzz.smithers.reset-node.v1"
    },
    "smithers_run_id": {
      "$ref": "#/$defs/identity"
    },
    "node_id": {
      "$ref": "#/$defs/identity"
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "resetPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "workflow_run_id",
        "generation",
        "requested_node_id",
        "iteration",
        "attempt",
        "reset_dependents",
        "policy",
        "node_count",
        "nodes"
      ],
      "properties": {
        "schema_version": {
          "const": "ultrafuzz.reset-plan.v1"
        },
        "workflow_run_id": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "requested_node_id": {
          "type": "string",
          "minLength": 1
        },
        "iteration": {
          "type": "integer",
          "minimum": 0
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "reset_dependents": {
          "type": "boolean"
        },
        "policy": {
          "const": "attempt-order"
        },
        "node_count": {
          "type": "integer",
          "minimum": 1
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workflow_run_id", "node_id", "iteration"],
            "properties": {
              "workflow_run_id": {
                "type": "string",
                "minLength": 1
              },
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "iteration": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000]+$"
    }
  }
}
