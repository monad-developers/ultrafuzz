{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultrafuzz:schema:runtime:materialize-audit:1",
  "title": "Ultrafuzz materialization audit record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "run_id",
    "timestamp",
    "operation",
    "mode",
    "unstaged",
    "confirmed",
    "allow_overwrite",
    "copies",
    "patches"
  ],
  "properties": {
    "schema_version": {
      "const": "ultrafuzz.materialize.audit.v1"
    },
    "audit_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "operation": {
      "const": "materializeSelection"
    },
    "mode": {
      "enum": ["dry-run", "unstaged-working-tree"]
    },
    "unstaged": {
      "const": true
    },
    "confirmed": {
      "type": "boolean"
    },
    "allow_overwrite": {
      "type": "boolean"
    },
    "commit_nonce_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "commit_witness_device": {
      "$ref": "#/$defs/decimalIdentity"
    },
    "commit_witness_inode": {
      "$ref": "#/$defs/decimalIdentity"
    },
    "copies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "destination", "size_bytes", "sha256"],
        "properties": {
          "source": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "destination": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "size_bytes": {
            "$ref": "#/$defs/nonNegativeSafeInteger"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "patches": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "size_bytes", "sha256"],
        "properties": {
          "source": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "size_bytes": {
            "$ref": "#/$defs/nonNegativeSafeInteger"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "review_signoff": {
      "$ref": "#/$defs/reviewSignoff"
    }
  },
  "dependentRequired": {
    "commit_nonce_sha256": ["commit_witness_device", "commit_witness_inode"],
    "commit_witness_device": ["commit_nonce_sha256", "commit_witness_inode"],
    "commit_witness_inode": ["commit_nonce_sha256", "commit_witness_device"]
  },
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "dry-run" } },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "commit_nonce_sha256": false,
          "commit_witness_device": false,
          "commit_witness_inode": false
        }
      }
    }
  ],
  "$defs": {
    "decimalIdentity": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "reviewSignoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "decision",
        "run_id",
        "target_commit",
        "target_tree",
        "target_clean",
        "target_worktree_digest",
        "graph_fingerprint",
        "final_report_digest",
        "selected_artifacts",
        "trusted_signers",
        "reviewer",
        "reviewed_at",
        "signing_key_id",
        "signature",
        "signoff_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "ultrafuzz.materialize.review-signoff.v1"
        },
        "decision": {
          "const": "accepted"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "target_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "target_tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "target_clean": {
          "const": true
        },
        "target_worktree_digest": {
          "$ref": "#/$defs/sha256"
        },
        "graph_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "final_report_digest": {
          "$ref": "#/$defs/sha256"
        },
        "selected_artifacts": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "destination", "sha256"],
            "properties": {
              "source": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "destination": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "trusted_signers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key_id", "algorithm", "public_key_sha256"],
            "properties": {
              "key_id": {
                "$ref": "#/$defs/safeId"
              },
              "algorithm": {
                "const": "ed25519"
              },
              "public_key_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "reviewer": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "signing_key_id": {
          "$ref": "#/$defs/safeId"
        },
        "signature": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        },
        "signoff_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonNegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}
