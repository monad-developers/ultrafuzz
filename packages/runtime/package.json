{
  "name": "@ultrafuzz/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp ../../.ultrafuzz/topology.yml dist/topology.yml && rm -rf dist/templates && cp -R src/templates dist/templates",
    "test": "pnpm --filter @ultrafuzz/runtime... build && rm -rf dist-test && tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "typecheck": "pnpm --filter @ultrafuzz/runtime^... build && tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@ultrafuzz/artifacts": "workspace:*",
    "@ultrafuzz/config": "workspace:*",
    "@ultrafuzz/prompts": "workspace:*",
    "@ultrafuzz/references": "workspace:*",
    "@ultrafuzz/security": "workspace:*",
    "@ultrafuzz/topology": "workspace:*"
  }
}
