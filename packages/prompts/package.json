{
  "name": "@ultrafuzz/prompts",
  "version": "0.1.0",
  "private": true,
  "description": "Packaged prompt catalog and rendering contracts for Ultrafuzz",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-prompt-assets.mjs",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "homepage": "https://github.com/monad-developers/ultrafuzz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monad-developers/ultrafuzz.git",
    "directory": "packages/prompts"
  },
  "bugs": {
    "url": "https://github.com/monad-developers/ultrafuzz/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
