{
  "name": "@ultrafuzz/evals",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-prompts.mjs && rm -rf dist/schema && cp -R schema dist/schema && node scripts/verify-schema-registry.mjs",
    "schema:check": "pnpm build",
    "test": "pnpm --filter @ultrafuzz/evals^... build && vitest run",
    "typecheck": "pnpm --filter @ultrafuzz/evals^... build && tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@ultrafuzz/artifacts": "workspace:*",
    "@ultrafuzz/config": "workspace:*",
    "@ultrafuzz/runtime": "workspace:*",
    "proper-lockfile": "4.1.2",
    "yaml": "^2.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  }
}
