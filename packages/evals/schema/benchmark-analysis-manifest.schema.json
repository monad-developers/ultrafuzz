{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultrafuzz:schema:evals:benchmark-analysis-manifest:1",
  "title": "Ultrafuzz private benchmark analysis output manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "privacy",
    "command",
    "source_archive",
    "source_sha256",
    "handoff_schema_version",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": "ultrafuzz.eval.benchmark-analysis-manifest.v1" },
    "privacy": { "const": "private-analysis-output-do-not-commit" },
    "command": { "enum": ["upset", "scores", "provenance", "table", "cost", "pairwise", "all"] },
    "source_archive": { "$ref": "urn:ultrafuzz:schema:evals:common:1#/$defs/nonEmptyString" },
    "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "handoff_schema_version": { "const": "ultrafuzz.eval.adjudication-handoff.v1" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\\\u0000]+$"
        },
        "size_bytes": { "$ref": "urn:ultrafuzz:schema:evals:common:1#/$defs/nonNegativeInteger" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
