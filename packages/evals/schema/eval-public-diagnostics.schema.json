{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultrafuzz:schema:evals:public-eval-diagnostics:2",
  "title": "Ultrafuzz public eval diagnostics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "benchmark",
    "lane",
    "model_slug",
    "model",
    "reasoning",
    "candidate_commit",
    "eval_run_id",
    "created_at",
    "lineage",
    "summary",
    "rows"
  ],
  "properties": {
    "schema_version": { "const": "ultrafuzz.modal.public-eval-diagnostics.v2" },
    "stage": { "const": "post-eval-pre-score" },
    "benchmark": { "enum": ["evmbench", "ultrafuzz-bench"] },
    "lane": { "enum": ["smoke", "threat-model", "full"] },
    "model_slug": { "$ref": "#/$defs/safeId" },
    "model": { "type": "string", "minLength": 1, "maxLength": 256 },
    "reasoning": { "type": "string", "minLength": 1, "maxLength": 64 },
    "candidate_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "eval_run_id": { "$ref": "#/$defs/safeId" },
    "created_at": { "$ref": "#/$defs/canonicalTimestamp" },
    "lineage": { "$ref": "#/$defs/lineage" },
    "summary": { "$ref": "#/$defs/summary" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "canonicalTimestamp": {
      "type": "string",
      "pattern": "^(?:[0-9]{4})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "workflowId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "rowCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2048
    },
    "failedNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "status", "timed_out"],
      "properties": {
        "node_id": { "$ref": "#/$defs/safeId" },
        "status": { "enum": ["failed", "timed-out"] },
        "timed_out": { "type": "boolean" },
        "failure_category": {
          "enum": ["agent-failure", "artifact-contract", "dependency-cascade", "provider-interruption"]
        },
        "failure_code": { "const": "task-output-validation-failure" },
        "failure_message": { "type": "string", "minLength": 1, "maxLength": 1000 }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "timed-out" } }
          },
          "then": { "properties": { "timed_out": { "const": true } } }
        },
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "failed" } }
          },
          "then": { "properties": { "timed_out": { "const": false } } }
        }
      ]
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_run_id",
        "generation",
        "attempt",
        "attempt_id",
        "config_fingerprint",
        "source_fingerprint",
        "image_fingerprint",
        "model_fingerprint"
      ],
      "properties": {
        "logical_run_id": { "$ref": "#/$defs/safeId" },
        "generation": { "$ref": "#/$defs/positiveInteger" },
        "attempt": { "$ref": "#/$defs/positiveInteger" },
        "attempt_id": { "$ref": "#/$defs/safeId" },
        "config_fingerprint": { "$ref": "#/$defs/fingerprint" },
        "source_fingerprint": { "$ref": "#/$defs/fingerprint" },
        "image_fingerprint": { "$ref": "#/$defs/fingerprint" },
        "model_fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "target_id",
        "variant_id",
        "trial_id",
        "run_status",
        "final_status",
        "workflow_status",
        "workflow_terminal",
        "terminal_disposition",
        "terminal_report_present",
        "workflow_ids",
        "diagnostic_codes",
        "failed_nodes",
        "scoring_ready",
        "reason_codes"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/safeId" },
        "target_id": { "$ref": "#/$defs/safeId" },
        "variant_id": { "$ref": "#/$defs/safeId" },
        "trial_id": { "$ref": "#/$defs/safeId" },
        "run_status": { "enum": ["launched", "failed", "missing"] },
        "final_status": {
          "enum": [
            "pending",
            "running",
            "paused",
            "succeeded",
            "failed",
            "timed-out",
            "canceled",
            "unavailable",
            "launched"
          ]
        },
        "workflow_status": {
          "enum": ["pending", "running", "paused", "succeeded", "failed", "timed-out", "canceled", "unavailable"]
        },
        "workflow_terminal": { "type": "boolean" },
        "terminal_disposition": {
          "enum": ["clean", "genuine-task-failures", "incomplete", "operational-failure", "unavailable"]
        },
        "terminal_report_present": { "type": "boolean" },
        "workflow_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/workflowId" }
        },
        "diagnostic_codes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeId" }
        },
        "failed_nodes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/failedNode" }
        },
        "scoring_ready": { "type": "boolean" },
        "reason_codes": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "run-record-missing",
              "launch-failed",
              "workflow-nonterminal",
              "workflow-not-scoreable",
              "final-status-not-scoreable",
              "terminal-disposition-not-scoreable",
              "workflow-id-missing",
              "terminal-report-missing"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned",
        "launched",
        "launch_failed",
        "run_records_missing",
        "workflow_succeeded",
        "workflow_failed",
        "workflow_nonterminal",
        "genuine_task_failure_rows",
        "terminal_reports_present",
        "scoring_ready"
      ],
      "properties": {
        "planned": { "$ref": "#/$defs/rowCount" },
        "launched": { "$ref": "#/$defs/rowCount" },
        "launch_failed": { "$ref": "#/$defs/rowCount" },
        "run_records_missing": { "$ref": "#/$defs/rowCount" },
        "workflow_succeeded": { "$ref": "#/$defs/rowCount" },
        "workflow_failed": { "$ref": "#/$defs/rowCount" },
        "workflow_nonterminal": { "$ref": "#/$defs/rowCount" },
        "genuine_task_failure_rows": { "$ref": "#/$defs/rowCount" },
        "terminal_reports_present": { "$ref": "#/$defs/rowCount" },
        "scoring_ready": { "type": "boolean" }
      }
    }
  }
}
