{
  "name": "@ultrafuzz/security",
  "version": "0.1.0",
  "private": true,
  "description": "Security boundaries and redaction utilities for Ultrafuzz",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "homepage": "https://github.com/monad-developers/ultrafuzz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monad-developers/ultrafuzz.git",
    "directory": "packages/security"
  },
  "bugs": {
    "url": "https://github.com/monad-developers/ultrafuzz/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
