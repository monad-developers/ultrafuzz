{
  "name": "@ultrafuzz/artifacts",
  "version": "0.1.0",
  "private": true,
  "description": "Artifact contracts, schemas, and durable run records for Ultrafuzz",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm --filter @ultrafuzz/artifacts^... build && sh -c 'rm -rf dist-test && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js' --",
    "typecheck": "pnpm --filter @ultrafuzz/artifacts^... build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ultrafuzz/prompts": "workspace:*",
    "@ultrafuzz/security": "workspace:*",
    "zod": "^4.4.3"
  },
  "homepage": "https://github.com/monad-developers/ultrafuzz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monad-developers/ultrafuzz.git",
    "directory": "packages/artifacts"
  },
  "bugs": {
    "url": "https://github.com/monad-developers/ultrafuzz/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
