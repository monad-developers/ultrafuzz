{
  "name": "@ultrafuzz/artifacts",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./strict-json": {
      "types": "./dist/strict-json.d.ts",
      "import": "./dist/strict-json.js",
      "default": "./dist/strict-json.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "schema:check": "pnpm build && node scripts/verify-schema-snapshots.mjs",
    "test": "pnpm --filter @ultrafuzz/security build && sh -c 'rm -rf dist-test && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js' --",
    "typecheck": "pnpm --filter @ultrafuzz/security build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ultrafuzz/security": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^4.4.3"
  }
}
