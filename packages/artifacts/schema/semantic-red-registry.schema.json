{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ultrafuzz.semantic-red-registry.v1"
    },
    "semantic_reds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stable_failure_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "lane_id": {
            "type": "string",
            "minLength": 1
          },
          "test_path": {
            "type": "string",
            "minLength": 1
          },
          "failing_test_name": {
            "type": "string",
            "minLength": 1
          },
          "focused_command": {
            "type": "string",
            "minLength": 1
          },
          "assertion": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "public_oracle_basis": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "pre_repair_file_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "stable_failure_hash",
          "lane_id",
          "test_path",
          "failing_test_name",
          "focused_command",
          "assertion",
          "observed",
          "expected",
          "public_oracle_basis",
          "pre_repair_file_hash"
        ],
        "additionalProperties": false
      }
    },
    "compile_or_harness_defects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stable_failure_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "lane_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": ["compile", "harness"]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_paths": {
            "minItems": 0,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": ["stable_failure_hash", "lane_id", "category", "summary", "evidence_paths"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "semantic_reds", "compile_or_harness_defects"],
  "additionalProperties": false,
  "$id": "urn:ultrafuzz:schema:artifacts:semantic-red-registry:1",
  "title": "Ultrafuzz semantic red registry"
}
