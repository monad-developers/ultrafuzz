{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ultrafuzz.reference-harness.v1"
    },
    "harness_author_attempt_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source_plan_artifacts": {
      "minItems": 0,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "authored_paths": {
      "minItems": 0,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reference_models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "covered_surfaces": {
            "minItems": 0,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "public_evidence_paths": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "implementation_rules_applied": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "known_gaps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "deployment_helpers": {
            "minItems": 0,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "model_id",
          "covered_surfaces",
          "public_evidence_paths",
          "implementation_rules_applied",
          "known_gaps",
          "deployment_helpers"
        ],
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "commands": {
          "minItems": 0,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "passed": {
          "type": "boolean"
        },
        "compiler_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "commands",
        "passed",
        "compiler_errors",
        "notes"
      ],
      "additionalProperties": false
    },
    "lane_readiness_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "harness_author_attempt_index",
    "source_plan_artifacts",
    "authored_paths",
    "reference_models",
    "validation",
    "lane_readiness_notes"
  ],
  "additionalProperties": false,
  "$id": "urn:ultrafuzz:schema:artifacts:reference-harness:1",
  "title": "Ultrafuzz differential reference harness"
}
