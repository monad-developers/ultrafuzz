{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ultrafuzz.selected-strategies.v1"
    },
    "strategies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "strategy_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "coverage_gap": {
            "type": "string",
            "minLength": 1
          },
          "evidence_paths": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "proposed_test_path": {
            "type": "string",
            "minLength": 1
          },
          "focused_command": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "enumerator_ids": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "validation_plan": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "strategy_id",
          "title",
          "rationale",
          "coverage_gap",
          "evidence_paths",
          "proposed_test_path",
          "focused_command",
          "priority",
          "enumerator_ids",
          "validation_plan"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "strategies"],
  "additionalProperties": false,
  "$id": "urn:ultrafuzz:schema:artifacts:selected-strategies:1",
  "title": "Ultrafuzz selected dynamic strategies"
}
