{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blog.monad.xyz/blog/ultrafuzz#schema/artifacts/reference-expectations",
  "title": "Ultrafuzz supplied reference expectation catalog",
  "type": "object",
  "required": ["schema_version", "expectations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "ultrafuzz.reference-expectations.v1" },
    "expectations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "benchmark_name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
