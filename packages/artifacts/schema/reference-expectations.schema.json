{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ultrafuzz.reference-expectations.v2"
    },
    "expectations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "benchmark_name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "expectations"],
  "additionalProperties": false,
  "$id": "urn:ultrafuzz:schema:artifacts:reference-expectations:2",
  "title": "Ultrafuzz supplied reference expectation catalog"
}
