{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultrafuzz:schema:artifacts:usage-ledger:2",
  "title": "Ultrafuzz usage ledger entry",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "workflow_run_id",
    "control_generation",
    "source_event_sequence",
    "observed_timestamp_ms",
    "node_id",
    "iteration",
    "attempt",
    "usage"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ultrafuzz.usage-ledger.v2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "workflow_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "control_generation": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_event_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observed_timestamp_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "iteration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "usage": {
      "type": "object",
      "required": ["model", "agent", "input_tokens", "output_tokens"],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fresh_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cache_read_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cache_write_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recorded_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
