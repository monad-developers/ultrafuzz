{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultrafuzz:schema:artifacts:usage-ledger:1",
  "title": "Ultrafuzz usage ledger entry",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "workflow_run_id",
    "source_event_id",
    "attempt_id",
    "checkpoint_generation_id",
    "observed_at",
    "usage",
    "usage_complete",
    "usage_incomplete_reasons"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "workflow_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "source_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "checkpoint_generation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "type": "number", "minimum": 0 },
        "output_tokens": { "type": "number", "minimum": 0 },
        "cache_read_tokens": { "type": "number", "minimum": 0 },
        "cache_write_tokens": { "type": "number", "minimum": 0 },
        "reasoning_tokens": { "type": "number", "minimum": 0 },
        "total_tokens": { "type": "number", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "model": { "type": "string", "minLength": 1 },
        "agent": { "type": "string", "minLength": 1 }
      }
    },
    "usage_complete": { "type": "boolean" },
    "usage_incomplete_reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code"],
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": ["usage-missing", "usage-malformed", "attempt-identity-missing"]
          },
          "field": {
            "enum": [
              "input_tokens",
              "output_tokens",
              "cache_read_tokens",
              "cache_write_tokens",
              "reasoning_tokens",
              "total_tokens"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "usage_complete": { "const": true } },
        "required": ["usage_complete"]
      },
      "then": {
        "properties": {
          "usage": {
            "anyOf": [
              { "type": "object", "required": ["input_tokens"], "properties": { "input_tokens": {} } },
              { "type": "object", "required": ["output_tokens"], "properties": { "output_tokens": {} } },
              {
                "type": "object",
                "required": ["cache_read_tokens"],
                "properties": { "cache_read_tokens": {} }
              },
              {
                "type": "object",
                "required": ["cache_write_tokens"],
                "properties": { "cache_write_tokens": {} }
              },
              { "type": "object", "required": ["reasoning_tokens"], "properties": { "reasoning_tokens": {} } },
              { "type": "object", "required": ["total_tokens"], "properties": { "total_tokens": {} } }
            ]
          },
          "usage_incomplete_reasons": { "type": "array", "maxItems": 0 }
        }
      },
      "else": {
        "properties": {
          "usage_incomplete_reasons": { "type": "array", "minItems": 1 }
        }
      }
    }
  ]
}
