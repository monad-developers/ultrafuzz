{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultrafuzz:schema:artifacts:analysis-bundle-accounting-summary:1",
  "title": "Ultrafuzz analysis bundle accounting summary",
  "type": "object",
  "required": [
    "schema_version",
    "run_count",
    "accounted_run_count",
    "runtime_observed_run_count",
    "runtime_seconds",
    "input_tokens",
    "output_tokens",
    "cache_read_tokens",
    "cache_write_tokens",
    "reasoning_tokens",
    "total_tokens",
    "estimated_spend_usd",
    "partial_pricing",
    "event_count",
    "priced_event_count",
    "unpriced_event_count"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ultrafuzz.analysis-bundle.v1"
    },
    "run_count": {
      "$ref": "#/$defs/count"
    },
    "accounted_run_count": {
      "$ref": "#/$defs/count"
    },
    "runtime_observed_run_count": {
      "$ref": "#/$defs/count"
    },
    "runtime_seconds": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "input_tokens": {
      "$ref": "#/$defs/count"
    },
    "output_tokens": {
      "$ref": "#/$defs/count"
    },
    "cache_read_tokens": {
      "$ref": "#/$defs/count"
    },
    "cache_write_tokens": {
      "$ref": "#/$defs/count"
    },
    "reasoning_tokens": {
      "$ref": "#/$defs/count"
    },
    "total_tokens": {
      "$ref": "#/$defs/count"
    },
    "estimated_spend_usd": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "partial_pricing": {
      "type": "boolean"
    },
    "event_count": {
      "$ref": "#/$defs/count"
    },
    "priced_event_count": {
      "$ref": "#/$defs/count"
    },
    "unpriced_event_count": {
      "$ref": "#/$defs/count"
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
