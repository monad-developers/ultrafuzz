{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ultrafuzz.generated-tests.v3"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_tests": {
      "maxItems": 1024,
      "type": "array",
      "items": {
        "$ref": "#/$defs/generatedTestEntry"
      },
      "uniqueItems": true
    },
    "support_files": {
      "maxItems": 1024,
      "type": "array",
      "items": {
        "$ref": "#/$defs/generatedTestEntry"
      },
      "uniqueItems": true
    },
    "provenance": {
      "$ref": "#/$defs/generatedTestProvenance"
    }
  },
  "required": ["schema_version", "run_id", "node_id", "generated_tests", "support_files"],
  "additionalProperties": false,
  "$id": "urn:ultrafuzz:schema:artifacts:generated-tests:3",
  "title": "Ultrafuzz generated tests manifest",
  "allOf": [
    {
      "if": {
        "properties": {
          "support_files": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": ["support_files"]
      },
      "then": {
        "properties": {
          "generated_tests": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": ["generated_tests"]
      }
    }
  ],
  "$defs": {
    "generatedTestEntry": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/generatedTestPath"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provenance": {
          "$ref": "#/$defs/generatedTestProvenance"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "framework": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": ["path", "size_bytes", "sha256"],
      "additionalProperties": false
    },
    "generatedTestPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^generated-tests\\/[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?:\\/[A-Za-z0-9][A-Za-z0-9._-]{0,127}){0,62}(?![\\s\\S])"
    },
    "generatedTestProvenance": {
      "type": "object",
      "properties": {
        "producer_node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "logical_node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "attempt_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "loop_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "model_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "agent_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "workflow_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "workflow_task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    }
  }
}
