{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ultrafuzz.invariant-campaign-plan.v1"
    },
    "available_vcpus": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "workers": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "configured_budget_seconds": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "finalization_reserve_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "backend": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "recon"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "command_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase": {
            "type": "string",
            "enum": ["validation", "smoke", "campaign", "finalization"]
          },
          "command": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["phase", "command"],
        "additionalProperties": false
      }
    },
    "paths": {
      "type": "object",
      "properties": {
        "corpus": {
          "type": "string",
          "minLength": 1
        },
        "cache": {
          "type": "string",
          "minLength": 1
        },
        "log": {
          "type": "string",
          "minLength": 1
        },
        "raw_results": {
          "type": "string",
          "minLength": 1
        },
        "reproducers": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["corpus", "cache", "log", "raw_results", "reproducers"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "available_vcpus",
    "workers",
    "configured_budget_seconds",
    "deadline",
    "finalization_reserve_seconds",
    "backend",
    "command_plan",
    "paths"
  ],
  "additionalProperties": false,
  "$id": "urn:ultrafuzz:schema:artifacts:invariant-campaign-plan:1",
  "title": "Ultrafuzz invariant campaign plan"
}
