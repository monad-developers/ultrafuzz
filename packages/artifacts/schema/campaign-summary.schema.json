{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ultrafuzz.campaign-summary.v2"
    },
    "outcome": {
      "type": "string",
      "enum": ["complete", "partial", "blocked"]
    },
    "implemented_property_suite_refs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "campaign_plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "backend_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fuzzer_backend": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["complete", "partial", "blocked", "failed", "timed-out", "unavailable"]
          },
          "result_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["fuzzer_backend", "status", "result_ref"],
        "additionalProperties": false
      }
    },
    "finding_refs": {
      "minItems": 0,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reproducer_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "blocker": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["finding_id", "path", "blocker"],
        "additionalProperties": false
      }
    },
    "failure_counts": {
      "type": "object",
      "properties": {
        "pre_deduplication": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "post_deduplication": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["pre_deduplication", "post_deduplication"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "outcome",
    "implemented_property_suite_refs",
    "campaign_plan_ref",
    "backend_results",
    "finding_refs",
    "reproducer_refs",
    "failure_counts"
  ],
  "additionalProperties": false,
  "$id": "urn:ultrafuzz:schema:artifacts:campaign-summary:2",
  "title": "Ultrafuzz invariant campaign summary"
}
