{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ultrafuzz.dependency-scope-matrix.v1"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dependency_id": {
            "type": "string",
            "minLength": 1
          },
          "contract_or_interface": {
            "type": "string",
            "minLength": 1
          },
          "dependency_type": {
            "type": "string",
            "minLength": 1
          },
          "touched_functions": {
            "minItems": 0,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "classification": {
            "type": "string",
            "enum": [
              "protocol-owned/in-scope",
              "explicitly-trusted/assumed-correct",
              "documented-out-of-scope-or-known-risk",
              "unknown/ambiguous"
            ]
          },
          "source_evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source_backed_scope_claim": {
            "type": "string",
            "minLength": 1
          },
          "in_scope_rationale": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "selected_test_cases": {
            "minItems": 0,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "expected_classification_if_red": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["production-bug", "incomplete-spec", "harness-defect", "false-positive"]
              },
              {
                "type": "null"
              }
            ]
          },
          "scope_notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "harness_notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "dependency_id",
          "contract_or_interface",
          "dependency_type",
          "touched_functions",
          "classification",
          "source_evidence",
          "source_backed_scope_claim",
          "selected_test_cases",
          "expected_classification_if_red"
        ],
        "additionalProperties": false
      }
    },
    "in_scope_test_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dependency_id": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["dependency_id", "rationale"],
        "additionalProperties": false
      }
    },
    "non_finding_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dependency_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["dependency_id", "reason"],
        "additionalProperties": false
      }
    },
    "generated_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": ["path", "checks"],
        "additionalProperties": false
      }
    },
    "source_backed_in_scope_rationales": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "dependency_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_paths": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": ["finding_candidate_id", "dependency_id", "evidence_paths"],
        "additionalProperties": false
      }
    },
    "coverage_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dependency_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["dependency_id", "reason"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "dependencies",
    "in_scope_test_targets",
    "non_finding_rows",
    "generated_tests",
    "source_backed_in_scope_rationales"
  ],
  "additionalProperties": false,
  "$id": "urn:ultrafuzz:schema:artifacts:dependency-scope-matrix:1",
  "title": "Ultrafuzz dependency scope matrix"
}
