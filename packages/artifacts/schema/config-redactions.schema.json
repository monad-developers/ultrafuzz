{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultrafuzz:schema:artifacts:config-redactions:2",
  "title": "Ultrafuzz resolved configuration redaction manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "placeholder", "entries"],
  "properties": {
    "schemaVersion": { "const": "ultrafuzz.config-redactions.v2" },
    "placeholder": { "const": "<redacted>" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "key",
          "reason",
          "restoreFrom",
          "requiredForWorkflowLaunch",
          "requiredForWorkflowSubmission"
        ],
        "properties": {
          "path": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "key": { "type": "string", "minLength": 1 },
          "reason": { "const": "sensitive-value" },
          "restoreFrom": { "enum": ["current-config", "environment"] },
          "requiredForWorkflowLaunch": { "type": "boolean" },
          "requiredForWorkflowSubmission": { "type": "boolean" }
        }
      }
    }
  }
}
