{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ultrafuzz.properties.v2"
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "reference_expectations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_node_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_property_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_node_id",
                "source_property_id"
              ],
              "additionalProperties": false
            }
          },
          "ledger_ids": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "description",
          "category",
          "priority",
          "sources"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "properties"
  ],
  "additionalProperties": false,
  "$id": "urn:ultrafuzz:schema:artifacts:properties:2",
  "title": "Ultrafuzz canonical property catalog"
}
