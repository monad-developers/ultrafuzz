{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ultrafuzz.coverage-goal.v1"
    },
    "target": {
      "type": "object",
      "properties": {
        "metric": {
          "type": "string",
          "const": "standardized-core-line-coverage-percent"
        },
        "value": {
          "type": "number",
          "const": 90
        }
      },
      "required": ["metric", "value"],
      "additionalProperties": false
    },
    "current_measurement": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "current_status": {
      "type": "string",
      "enum": ["not-run", "in-progress", "target-met", "below-target", "blocked"]
    },
    "planned_commands": {
      "minItems": 0,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "stop_conditions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "timeout_seconds": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "finalization_reserve_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "coverage-tooling-blocked",
              "production-source-attribution-blocked",
              "harness-build-blocked",
              "dependency-blocked",
              "time-budget-exhausted",
              "no-reachable-target"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_paths": {
            "minItems": 0,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": ["category", "summary", "evidence_paths"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "target",
    "current_measurement",
    "current_status",
    "planned_commands",
    "stop_conditions",
    "timeout_seconds",
    "finalization_reserve_seconds",
    "blockers"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "current_status": {
            "const": "not-run"
          }
        },
        "required": ["current_status"]
      },
      "then": {
        "properties": {
          "current_measurement": {
            "type": "null"
          },
          "blockers": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "current_status": {
            "const": "in-progress"
          }
        },
        "required": ["current_status"]
      },
      "then": {
        "properties": {
          "blockers": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "current_status": {
            "const": "target-met"
          }
        },
        "required": ["current_status"]
      },
      "then": {
        "properties": {
          "current_measurement": {
            "type": "number",
            "minimum": 90,
            "maximum": 100
          },
          "blockers": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "current_status": {
            "const": "below-target"
          }
        },
        "required": ["current_status"]
      },
      "then": {
        "properties": {
          "current_measurement": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 90
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "current_status": {
            "const": "blocked"
          }
        },
        "required": ["current_status"]
      },
      "then": {
        "properties": {
          "blockers": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$id": "urn:ultrafuzz:schema:artifacts:coverage-goal:1",
  "title": "Ultrafuzz invariant coverage goal"
}
