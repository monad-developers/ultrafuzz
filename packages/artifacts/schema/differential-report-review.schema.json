{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ultrafuzz.differential-report-review.v1"
    },
    "campaign_status": {
      "type": "string",
      "enum": ["complete", "incomplete", "blocked_by_preserved_reds"]
    },
    "production_bug_reds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stable_failure_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "lane_id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_paths": {
            "minItems": 0,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": ["stable_failure_hash", "lane_id", "summary", "evidence_paths"],
        "additionalProperties": false
      }
    },
    "harness_or_reference_repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stable_failure_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "lane_id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_paths": {
            "minItems": 0,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": ["stable_failure_hash", "lane_id", "summary", "evidence_paths"],
        "additionalProperties": false
      }
    },
    "missing_or_deferred_lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lane_id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_paths": {
            "minItems": 0,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": ["lane_id", "summary", "evidence_paths"],
        "additionalProperties": false
      }
    },
    "report_rows_ready": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stable_failure_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "lane_id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_paths": {
            "minItems": 0,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": ["stable_failure_hash", "lane_id", "summary", "evidence_paths"],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "campaign_status",
    "production_bug_reds",
    "harness_or_reference_repairs",
    "missing_or_deferred_lanes",
    "report_rows_ready",
    "notes"
  ],
  "additionalProperties": false,
  "$id": "urn:ultrafuzz:schema:artifacts:differential-report-review:1",
  "title": "Ultrafuzz differential report review"
}
