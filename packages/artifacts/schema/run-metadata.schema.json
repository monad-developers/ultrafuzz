{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultrafuzz:schema:artifacts:run-metadata:2",
  "title": "Ultrafuzz run metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "mode",
    "workflow_ids",
    "redacted_config_fingerprint",
    "forge_guard"
  ],
  "properties": {
    "schema_version": {
      "const": "ultrafuzz.run-metadata.v2"
    },
    "run_id": {
      "$ref": "#/$defs/safeId"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_run_id": {
      "$ref": "#/$defs/safeId"
    },
    "mode": {
      "enum": ["run", "resume", "replay", "fork"]
    },
    "workflow_ids": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "redacted_config_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "forge_guard": {
      "$ref": "#/$defs/forgeGuard"
    },
    "workflow": {
      "$ref": "#/$defs/workflow"
    },
    "accounting": {
      "$ref": "#/$defs/accounting"
    },
    "prompt_digest": {
      "$ref": "#/$defs/sha256"
    },
    "audit_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "effective",
        "catalog_schema_version",
        "settings",
        "catalog_digest",
        "effective_topology_path",
        "topology_path_origin",
        "topology_digest",
        "prompt_digest",
        "expanded_graph_fingerprint",
        "effective_settings",
        "setting_origins",
        "overridden_settings",
        "topology_overridden"
      ],
      "properties": {
        "requested": {
          "type": "string",
          "minLength": 1
        },
        "effective": {
          "type": "string",
          "minLength": 1
        },
        "catalog_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "settings": {
          "type": "object"
        },
        "declared_topology_path": {
          "type": "string",
          "minLength": 1
        },
        "catalog_digest": {
          "$ref": "#/$defs/sha256"
        },
        "effective_topology_path": {
          "type": "string",
          "minLength": 1
        },
        "topology_path_origin": {
          "type": "string",
          "minLength": 1
        },
        "topology_digest": {
          "$ref": "#/$defs/sha256"
        },
        "prompt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "expanded_graph_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "effective_settings": {
          "type": "object"
        },
        "setting_origins": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "overridden_settings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "topology_overridden": {
          "type": "boolean"
        }
      }
    },
    "data_governance": {
      "$ref": "#/$defs/dataGovernance"
    }
  },
  "dependentRequired": {
    "accounting": ["workflow"]
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "workflow": {}
        },
        "required": ["workflow"]
      },
      "then": {
        "type": "object",
        "properties": {
          "workflow_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "workflow_ids": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "dataGovernance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "path",
        "sha256",
        "policy_digest",
        "input_digest",
        "sensitivity",
        "acknowledgement_status",
        "review_signoff_authorities"
      ],
      "properties": {
        "schema_version": {
          "const": "ultrafuzz.data-governance-provenance.v1"
        },
        "path": {
          "const": "data-governance.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "input_digest": {
          "$ref": "#/$defs/sha256"
        },
        "sensitivity": {
          "enum": ["public", "private"]
        },
        "acknowledgement_status": {
          "enum": ["approved", "not-required", "pending"]
        },
        "review_signoff_authorities": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key_id", "algorithm", "public_key_spki_base64", "public_key_sha256"],
            "properties": {
              "key_id": {
                "$ref": "#/$defs/safeId"
              },
              "algorithm": {
                "const": "ed25519"
              },
              "public_key_spki_base64": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$"
              },
              "public_key_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "forgeGuard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "active", "virtual_memory_limit_kb", "rayon_threads"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean"
        },
        "virtual_memory_limit_kb": {
          "type": "integer",
          "minimum": 1
        },
        "rayon_threads": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "compiled_run_id",
        "name",
        "path",
        "evidence_path",
        "expanded_graph_path",
        "config_path",
        "input_path",
        "tasks_path",
        "control_integrity_path",
        "control_generation",
        "workflow_link_id",
        "execution_snapshot_path",
        "task_node_ids"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "compiled_run_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "evidence_path": {
          "type": "string",
          "minLength": 1
        },
        "expanded_graph_path": {
          "type": "string",
          "minLength": 1
        },
        "config_path": {
          "type": "string",
          "minLength": 1
        },
        "input_path": {
          "type": "string",
          "minLength": 1
        },
        "tasks_path": {
          "type": "string",
          "minLength": 1
        },
        "control_integrity_path": {
          "type": "string",
          "minLength": 1
        },
        "control_generation": {
          "$ref": "#/$defs/sha256"
        },
        "workflow_link_id": {
          "$ref": "#/$defs/uuid"
        },
        "execution_snapshot_path": {
          "type": "string",
          "minLength": 1
        },
        "task_node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "usageComponent": {
      "enum": ["uncached_input", "cache_read", "cache_write", "output", "reasoning"]
    },
    "componentCosts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncached_input", "cache_read", "cache_write", "output", "reasoning"],
      "properties": {
        "uncached_input": {
          "type": "number",
          "minimum": 0
        },
        "cache_read": {
          "type": "number",
          "minimum": 0
        },
        "cache_write": {
          "type": "number",
          "minimum": 0
        },
        "output": {
          "type": "number",
          "minimum": 0
        },
        "reasoning": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "usageIncompleteReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "enum": [
            "component-usage-unavailable",
            "component-usage-estimated",
            "component-breakdown-incomplete",
            "ledger-entry-malformed"
          ]
        },
        "field": {
          "enum": ["input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "reasoning_tokens"]
        },
        "component": {
          "$ref": "#/$defs/usageComponent"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_generation_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pricingIncompleteReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "enum": [
            "model-pricing-unavailable",
            "component-rate-unavailable",
            "event-pricing-reported-partial",
            "price-unavailable",
            "ledger-entry-malformed"
          ]
        },
        "component": {
          "$ref": "#/$defs/usageComponent"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_generation_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "accountingSummary": {
      "type": "object",
      "required": [
        "uncached_input_tokens",
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "reasoning_tokens",
        "inclusive_token_total",
        "billable_token_total",
        "total_tokens",
        "tokens_used",
        "estimated_spend",
        "component_costs_usd",
        "usage_complete",
        "usage_incomplete_reasons",
        "pricing_complete",
        "pricing_incomplete_reasons",
        "partial_pricing",
        "cache_read_pricing_estimated",
        "event_count",
        "priced_event_count",
        "unpriced_event_count",
        "models",
        "agents"
      ],
      "properties": {
        "uncached_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "inclusive_token_total": {
          "type": "integer",
          "minimum": 0
        },
        "billable_token_total": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_used": {
          "type": "string",
          "pattern": "^[0-9][0-9,]*$"
        },
        "estimated_spend": {
          "type": "string",
          "minLength": 1
        },
        "estimated_spend_usd": {
          "type": "number",
          "minimum": 0
        },
        "component_costs_usd": {
          "$ref": "#/$defs/componentCosts"
        },
        "provided_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "usage_complete": {
          "type": "boolean"
        },
        "usage_incomplete_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/usageIncompleteReason"
          }
        },
        "pricing_complete": {
          "type": "boolean"
        },
        "pricing_incomplete_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pricingIncompleteReason"
          }
        },
        "partial_pricing": {
          "type": "boolean"
        },
        "cache_read_pricing_estimated": {
          "type": "boolean"
        },
        "cache_read_ratio_used": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "priced_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "unpriced_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "models": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "agents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "accountingSegment": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/accountingSummary"
        },
        {
          "type": "object",
          "required": ["control_generation", "workflow_run_id", "source_event_sequences", "attempts"],
          "properties": {
            "control_generation": {
              "$ref": "#/$defs/sha256"
            },
            "workflow_run_id": {
              "type": "string",
              "minLength": 1
            },
            "source_event_sequences": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "attempts": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["node_id", "iteration", "attempt"],
                "properties": {
                  "node_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "iteration": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "attempt": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "cumulativeAccounting": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/accountingSummary"
        },
        {
          "type": "object",
          "required": ["source_run_ids"],
          "properties": {
            "source_run_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/safeId"
              }
            }
          }
        }
      ]
    },
    "modelPricingTier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contextTokens", "inputUsdPerMillion", "outputUsdPerMillion"],
      "properties": {
        "contextTokens": {
          "type": "integer",
          "minimum": 1
        },
        "inputUsdPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "cachedInputUsdPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "cacheWriteUsdPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "outputUsdPerMillion": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "modelPricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputUsdPerMillion", "outputUsdPerMillion"],
      "properties": {
        "inputUsdPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "cachedInputUsdPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "cacheWriteUsdPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "outputUsdPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "contextTiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modelPricingTier"
          }
        }
      }
    },
    "pricingCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "status", "resolved_models", "unresolved_models", "model_prices"],
      "properties": {
        "source": {
          "enum": ["models.dev", "configured-catalog", "disabled"]
        },
        "status": {
          "enum": ["available", "disabled", "unavailable"]
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        },
        "resolved_models": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unresolved_models": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "model_prices": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/modelPricing"
          }
        }
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "workflow_run_id",
        "current",
        "segments",
        "cumulative",
        "checkpoint",
        "pricing_catalog",
        "updated_at"
      ],
      "properties": {
        "schema_version": {
          "const": "ultrafuzz.accounting.v3"
        },
        "source": {
          "const": "usage-ledger"
        },
        "workflow_run_id": {
          "type": "string",
          "minLength": 1
        },
        "current": {
          "$ref": "#/$defs/accountingSegment"
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/accountingSegment"
          }
        },
        "cumulative": {
          "$ref": "#/$defs/cumulativeAccounting"
        },
        "checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "ledger_event_count",
            "last_source_event_sequence",
            "control_generation",
            "workflow_run_id"
          ],
          "properties": {
            "schema_version": {
              "const": "ultrafuzz.accounting-checkpoint.v1"
            },
            "ledger_event_count": {
              "type": "integer",
              "minimum": 1
            },
            "last_source_event_sequence": {
              "type": "integer",
              "minimum": 0
            },
            "control_generation": {
              "$ref": "#/$defs/sha256"
            },
            "workflow_run_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "pricing_catalog": {
          "$ref": "#/$defs/pricingCatalog"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
