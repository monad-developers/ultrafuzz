{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ultrafuzz.property-lens.v2"
    },
    "properties": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "reference_expectations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": ["id", "description", "category", "priority"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "properties"],
  "additionalProperties": false,
  "$id": "urn:ultrafuzz:schema:artifacts:property-lens:2",
  "title": "Ultrafuzz property lens catalog"
}
