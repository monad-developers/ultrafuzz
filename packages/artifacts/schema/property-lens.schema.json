{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blog.monad.xyz/blog/ultrafuzz#schema/artifacts/properties/lens",
  "title": "Ultrafuzz property lens catalog",
  "type": "object",
  "required": ["schema_version", "properties"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ultrafuzz.property-lens.v1"
    },
    "properties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "category", "priority"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": ["high", "medium", "low"]
          },
          "reference_expectations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
