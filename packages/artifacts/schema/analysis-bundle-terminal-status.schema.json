{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultrafuzz:schema:artifacts:analysis-bundle-terminal-status:1",
  "title": "Ultrafuzz analysis bundle terminal status",
  "type": "object",
  "required": ["schema_version", "terminal", "status", "run_count", "status_counts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "ultrafuzz.analysis-bundle.v1" },
    "terminal": { "type": "boolean" },
    "status": {
      "enum": ["pending", "running", "paused", "succeeded", "failed", "timed-out", "canceled", "mixed", "unknown"]
    },
    "run_count": { "$ref": "#/$defs/count" },
    "status_counts": {
      "type": "object",
      "required": ["pending", "running", "paused", "succeeded", "failed", "timed-out", "canceled", "unknown"],
      "additionalProperties": false,
      "properties": {
        "pending": { "$ref": "#/$defs/count" },
        "running": { "$ref": "#/$defs/count" },
        "paused": { "$ref": "#/$defs/count" },
        "succeeded": { "$ref": "#/$defs/count" },
        "failed": { "$ref": "#/$defs/count" },
        "timed-out": { "$ref": "#/$defs/count" },
        "canceled": { "$ref": "#/$defs/count" },
        "unknown": { "$ref": "#/$defs/count" }
      }
    },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  }
}
