{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultrafuzz:schema:artifacts:analysis-bundle-attempt-history:1",
  "title": "Ultrafuzz analysis bundle attempt history",
  "type": "object",
  "required": ["schema_version", "attempts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "ultrafuzz.analysis-bundle.v1" },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ordinal", "launcher_status", "workflow_status"],
        "additionalProperties": false,
        "properties": {
          "ordinal": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "launcher_status": { "enum": ["launched", "failed"] },
          "workflow_status": {
            "enum": ["pending", "running", "paused", "succeeded", "failed", "timed-out", "canceled", "unknown"]
          },
          "started_at": { "$ref": "#/$defs/timestamp" },
          "finished_at": { "$ref": "#/$defs/timestamp" }
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  }
}
