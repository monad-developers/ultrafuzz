{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultrafuzz:schema:artifacts:analysis-bundle-attempt-history:1",
  "title": "Ultrafuzz analysis bundle attempt history",
  "type": "object",
  "required": ["schema_version", "attempts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "ultrafuzz.analysis-bundle.v1" },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ordinal", "launcher_status", "workflow_status"],
        "additionalProperties": false,
        "properties": {
          "ordinal": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "launcher_status": { "enum": ["launched", "failed"] },
          "workflow_status": {
            "enum": ["pending", "running", "paused", "succeeded", "failed", "timed-out", "canceled", "unknown"]
          },
          "started_at": { "$ref": "#/$defs/timestamp" },
          "finished_at": { "$ref": "#/$defs/timestamp" }
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    }
  }
}
