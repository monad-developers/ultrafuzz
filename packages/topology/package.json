{
  "name": "@ultrafuzz/topology",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm --filter @ultrafuzz/topology^... build && vitest run",
    "typecheck": "pnpm --filter @ultrafuzz/topology^... build && tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@ultrafuzz/artifacts": "workspace:*",
    "@ultrafuzz/prompts": "workspace:*",
    "@ultrafuzz/references": "workspace:*",
    "yaml": "2.9.0"
  }
}
