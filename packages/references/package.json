{
  "name": "@ultrafuzz/references",
  "version": "0.1.0",
  "private": true,
  "description": "Pinned reference materialization and validation for Ultrafuzz",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp ../../.ultrafuzz/references.yml dist/default-references.yml",
    "test": "pnpm --filter @ultrafuzz/references... build && rm -rf dist-test && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "typecheck": "pnpm --filter @ultrafuzz/references^... build && tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@ultrafuzz/artifacts": "workspace:*",
    "yaml": "^2.8.0"
  },
  "homepage": "https://github.com/monad-developers/ultrafuzz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monad-developers/ultrafuzz.git",
    "directory": "packages/references"
  },
  "bugs": {
    "url": "https://github.com/monad-developers/ultrafuzz/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
