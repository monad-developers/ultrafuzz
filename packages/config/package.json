{
  "name": "@ultrafuzz/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp ../../ultrafuzz.toml dist/ultrafuzz.toml && cp audit-profiles.yml dist/audit-profiles.yml && rm -rf dist/topologies && cp -R topologies dist/topologies",
    "test": "pnpm --filter @ultrafuzz/security build && vitest run",
    "typecheck": "pnpm --filter @ultrafuzz/security build && tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@ultrafuzz/security": "workspace:*",
    "smol-toml": "^1.7.0",
    "yaml": "^2.8.0",
    "zod": "^4.4.3"
  }
}
