  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "ari",
        "risk_mass",
        "risk_capacity",
        "band_grade",
        "grade",
        "severity_gate_grade_cap",
        "threats"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "ari": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "risk_mass": {
          "type": "number",
          "minimum": 0
        },
        "risk_capacity": {
          "type": "number",
          "minimum": 0
        },
        "band_grade": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "F"
          ]
        },
        "grade": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "F"
          ]
        },
        "severity_gate_grade_cap": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "enum": [
                "B",
                "C",
                "D",
                "F"
              ]
            }
          ]
        },
        "threats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/threat"
          }
        }
      }
    },
    "threat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "severity",
        "weight",
        "controls",
        "gap",
        "residual_mass"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "Low",
            "Medium",
            "High",
            "Critical"
          ]
        },
        "weight": {
          "type": "integer",
          "enum": [
            1,
            3,
            5,
            8
          ]
        },
        "controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/control"
          }
        },
        "gap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "residual_mass": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "effectiveness",
        "effectiveness_rationale",
        "independence_group"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^C[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "Eliminated",
            "Applied",
            "Partial",
            "Not Applied"
          ]
        },
        "effectiveness": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "enum": [
                0,
                0.05,
                0.1,
                0.15,
                0.2,
                0.25,
                0.3,
                0.35,
                0.4,
                0.45,
                0.5,
                0.55,
                0.6,
                0.65,
                0.7,
                0.75,
                0.8,
                0.85,
                0.9,
                0.95
              ]
            }
          ]
        },
        "effectiveness_rationale": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "independence_group": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    }
  }
}
