          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "skill_commit": {
      "type": "string",
      "enum": [
        "d4846045a1e4079676e5ea539af7db8bfa8c3c9e"
      ]
    },
    "ari_commit": {
      "type": "string",
      "enum": [
        "847f5e300d1977be9a437ead50826ddd5930a01d"
      ]
    },
    "baseline_commit": {
      "type": "string",
      "enum": [
        "a634d948038f502e5e677477138dca0c763e2380"
      ]
    },
    "final_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
