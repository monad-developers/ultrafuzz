{
  "name": "ultrafuzz",
  "version": "0.2.0",
  "description": "Prompt-driven audits on Modal",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ultrafuzz": "dist/cli.js"
  },
  "files": ["dist", "profiles", "plugins", "web", "Dockerfile", "README.md", "LICENSE.md"],
