    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": "github:monad-developers/ultrafuzz"
