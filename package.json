{
  "name": "ultrafuzz",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "benchmark:evmbench": "pnpm --filter @ultrafuzz/evmbench benchmark",
    "benchmark:evmbench:lock": "pnpm --filter @ultrafuzz/evmbench lock",
    "build": "pnpm -r build",
    "benchmark:check": "pnpm --filter @ultrafuzz/cli... build && pnpm --filter @ultrafuzz/config test && pnpm --filter @ultrafuzz/runtime test && pnpm --filter @ultrafuzz/evals test && node packages/cli/dist/index.js eval history --check --project .",
    "ci": "pnpm -w format:check && pnpm -w lint && pnpm -w build && pnpm -w validate:release",
    "docs:check": "node scripts/docs-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"packages/**/*.{ts,js,mjs}\" \"scripts/**/*.{ts,js,mjs}\" \"*.{js,mjs}\"",
    "lint:fix": "eslint \"packages/**/*.{ts,js,mjs}\" \"scripts/**/*.{ts,js,mjs}\" \"*.{js,mjs}\" --fix",
    "test": "pnpm run test:ci-scripts && pnpm -r test",
    "test:ci-scripts": "pnpm --filter @ultrafuzz/evals... build && bun test scripts/ci/*.test.ts",
    "validate:release": "node scripts/validate-release.mjs",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@ultrafuzz/modal": "workspace:*",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^3.2.4",
    "yaml": "^2.8.0"
  },
  "workspaces": [
    "packages/security",
    "packages/references",
    "packages/config",
    "packages/prompts",
    "packages/topology",
    "packages/artifacts",
    "packages/runtime",
    "packages/evals",
    "packages/dashboard",
    "packages/evmbench",
    "packages/cli"
  ]
}
