{
  "name": "ultrafuzz",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "ci": "pnpm -w format:check && pnpm -w lint && pnpm -w build && pnpm -w validate:release",
    "docs:check": "node scripts/docs-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"packages/**/*.{ts,js,mjs}\" \"scripts/**/*.{ts,js,mjs}\" \"*.{js,mjs}\"",
    "lint:fix": "eslint \"packages/**/*.{ts,js,mjs}\" \"scripts/**/*.{ts,js,mjs}\" \"*.{js,mjs}\" --fix",
    "test": "pnpm -r test",
    "validate:release": "node scripts/validate-release.mjs",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@ultrafuzz/modal": "workspace:*",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^3.2.4"
  },
  "workspaces": [
    "packages/security",
    "packages/references",
    "packages/config",
    "packages/prompts",
    "packages/topology",
    "packages/artifacts",
    "packages/runtime",
    "packages/evals",
    "packages/dashboard",
    "packages/cli"
  ]
}
