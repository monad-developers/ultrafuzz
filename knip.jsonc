{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // Operators run the eval runner from the repository root with `pnpm exec ultrafuzz-modal`
      // (docs/how-to/run-evals-on-modal.md); nothing imports the package by name.
      "ignoreDependencies": ["@ultrafuzz/modal"],
      "entry": ["scripts/validate-audit-profile-package.mjs", "scripts/ci/prepare-modal-benchmarks.mjs"]
    },
    "packages/dashboard": {
      "entry": ["frontend/public/theme-bootstrap.js"]
    },
    "packages/evals": {
      "entry": ["src/index.ts", "test/append-eval-run-record-child.mjs"]
    },
    "packages/evmbench": {
      "entry": ["src/{index,cli,adapter-cli,update-lock}.ts"]
    },
    "packages/modal": {
      "entry": [
        "src/index.ts",
        "src/cli.ts",
        "scripts/prepare-smithers-seed.mjs",
        "src/worker.ts",
        "src/smoke-worker.ts"
      ]
    },
    "packages/runtime": {
      "entry": ["src/templates/**/*.tsx"],
      "ignoreDependencies": ["@moonshot-ai/kimi-code", "@smthrs/driver"],
      "ignoreUnresolved": ["^__ULTRAFUZZ_WORKFLOW_IMPORT__$", "^\\.\\./agents/index\\.ts$"]
    }
  }
}
